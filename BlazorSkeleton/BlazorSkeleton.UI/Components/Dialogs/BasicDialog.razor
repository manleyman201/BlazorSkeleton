<div class="container-fluid">
    <div class="row">
        <div class="col">
            <RadzenText Text="@Message" />
        </div>
    </div>
    <div class="row mt-3">
        <div class="col text-end">
            <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="@(() => Close(false))" />
