@typeparam TItem where TItem : class

<div class="row bg-white">
    <div class="col">
        <div class="d-flex justify-content-between align-items-center my-2">
            <h3 class="m-0">@Title</h3>
            <RadzenButton Text="Export to Excel (CSV)" Icon="download" Click="@ExportToCsv" Disabled="@(Data.Count == 0)" />
        </div>

        <RadzenDataGrid TItem="TItem" Data="@Data" IsLoading="@IsLoading"
                        AllowPaging="true" PageSize="@PageSize" PageSizeOptions="@PageSizeOptions" ShowPagingSummary="true"
                        AllowSorting="true" AllowFiltering="true" AllowColumnResize="true">
            <Columns>
                @Columns
            </Columns>
        </RadzenDataGrid>
    </div>
</div>
