<Project>
  <!--
    Central Package Management: every package version lives here, so a version bump is one edit.
    Projects reference packages with <PackageReference Include="..." /> and no Version attribute.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Lets the PackageVersion entries below also override versions of transitive dependencies. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- Data access (stored procedures via Data/Providers/Sql/SqlDataProvider). -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="6.1.7" />
  </ItemGroup>

  <!-- ASP.NET Core / Microsoft identity (moved to the .NET 10 train). -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.Negotiate" Version="10.0.12" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Identity.Web" Version="4.13.0" />
    <PackageVersion Include="Microsoft.Identity.Web.UI" Version="4.13.0" />
  </ItemGroup>

  <!-- API documentation (OpenAPI document + Swagger UI). -->
  <ItemGroup>
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <!-- Azure configuration / Key Vault. -->
  <ItemGroup>
    <PackageVersion Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.4.0" />
    <PackageVersion Include="Azure.Identity" Version="1.17.2" />
    <PackageVersion Include="Azure.Security.KeyVault.Secrets" Version="4.7.0" />
  </ItemGroup>

  <!-- UI. Radzen stays on 4.x; Radzen 5+ has breaking theme/API changes. -->
  <ItemGroup>
    <PackageVersion Include="Radzen.Blazor" Version="4.28.9" />
    <PackageVersion Include="Blazored.LocalStorage" Version="4.5.0" />
  </ItemGroup>

  <!-- Logging. Same Serilog set as the original app (serilog*.json depends on these sinks/enrichers). -->
  <ItemGroup>
    <PackageVersion Include="Serilog" Version="3.1.1" />
    <PackageVersion Include="Serilog.AspNetCore" Version="8.0.1" />
    <PackageVersion Include="Serilog.Enrichers.AspNetCore" Version="1.0.0" />
    <PackageVersion Include="Serilog.Enrichers.AspNetCore.HttpContext" Version="1.0.1" />
    <PackageVersion Include="Serilog.Enrichers.Context" Version="4.6.5" />
    <PackageVersion Include="Serilog.Enrichers.CorrelationId" Version="3.0.1" />
    <PackageVersion Include="Serilog.Enrichers.Environment" Version="2.3.0" />
    <PackageVersion Include="Serilog.Enrichers.Process" Version="2.0.2" />
    <PackageVersion Include="Serilog.Enrichers.Thread" Version="3.1.0" />
    <PackageVersion Include="Serilog.Exceptions" Version="8.4.0" />
    <PackageVersion Include="Serilog.Extensions.Logging" Version="8.0.0" />
    <PackageVersion Include="Serilog.Formatting.Compact" Version="2.0.0" />
    <PackageVersion Include="Serilog.Settings.Configuration" Version="8.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="5.0.1" />
    <PackageVersion Include="Serilog.Sinks.Debug" Version="2.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="5.0.0" />
    <PackageVersion Include="Serilog.Sinks.MSSqlServer" Version="6.6.0" />
  </ItemGroup>

  <!-- Transitive security pins (via CentralPackageTransitivePinningEnabled). Not referenced directly by any project.
       System.Linq.Dynamic.Core: pulled in at 1.3.7 by Radzen.Blazor 4.x (GHSA-4cv2-4hjh-77rx). -->
  <ItemGroup>
    <PackageVersion Include="System.Linq.Dynamic.Core" Version="1.7.4" />
  </ItemGroup>

  <!-- Testing. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.1" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
  </ItemGroup>
</Project>
