{
    "DBConnections": {
        "DBConnection": [
            {
                "Name": "AppDatabase",
                "ImpersonateUser": true,
                "Instance": "<qa-sql-server>.sprouts.fm",
                "Database": "<DatabaseName>",
                "UserName": "<SQL_USER_NAME>",
                "UserPassword": "<SQL_PASSWORD>",
                "ApplicationIntent": "READONLY"
            }
        ]
    },
    "DetailedErrors": true,
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*"
}
